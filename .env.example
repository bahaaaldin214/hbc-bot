# Copy to .env (gitignored) and fill in. Never commit the real file.

# Bot token: Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Lab server ID (right-click server -> Copy Server ID). REQUIRED for server use:
# the bot refuses commands from any other server.
HBC_GUILD_ID=

# Who may run commands in the server is NOT set here. Use Discord:
#   Server Settings -> Integrations -> hbc-bot -> /bahaa, /jobs, /reload
# They start admin-only; add roles/members and restrict channels there.

# Channels where informational slash replies stay in history (not ephemeral).
# Right-click channel -> Copy Channel ID. Errors are always private; job embeds are always public.
# HBC_PUBLIC_CHANNEL_IDS=123456789012345678

# Direct messages: Discord has no per-user permissions in DMs, so the bot keeps an allowlist.
# HBC_ALLOW_DM=0 removes the commands from DMs entirely. Fail closed if the list is empty.
# Right-click your avatar -> Copy User ID (Developer Mode on).
HBC_ALLOW_DM=1
HBC_DM_USER_IDS=

# Which tools appear on Discord is set per tool in the tools tree:
#   <tool>/config.toml            [discord] guild / dm, [run] host
#   <tool>/<command>/args.toml    required for a command to be runnable from Discord
# This bot's host name; must match a tool's config.toml [run] host.
# HBC_HOST=vosslink

# Optional tuning
# HBC_EMBED_EDIT_INTERVAL_S=2
# HBC_MAX_LOG_UPLOAD_BYTES=8388608
# HBC_MAX_UPLOAD_BYTES=8388608     # largest file accepted for a `file` arg
# HBC_CONFIRM_TIMEOUT_S=300        # how long a confirm button stays valid

# Where the bahaa tools live (default below is vosslink).
BAHAA_TOOLS_DIR=/mnt/nfs/lss/vosslabhpc/Users/bahaa/tools
# BAHAA_LAUNCHER=          # default: $BAHAA_TOOLS_DIR/bahaa
# HBC_BASH=bash            # bash executable used to run the launcher

# Bot state (job history + per-job logs + staged uploads). Relative paths are relative to the working dir.
# HBC_BOT_DATA_DIR=data

# Kill a job after this many seconds (0 = never). Default 24h.
# HBC_JOB_TIMEOUT_S=86400

# Show the last lines of tool output in the embed. Set to 0 if output can contain subject data.
# HBC_SHOW_LOG_TAIL=1
